{
  "database": {
    "rules": "database.rules.stage1.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  },
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix functions run build"]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "database": { "port": 9000 },
    "ui": { "enabled": false }
  }
}
