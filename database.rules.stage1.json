      }
    },
    "AFC San Jose": {
      ".read": true,
      ".write": "auth != null && root.child('Admins').child(auth.uid).exists()",
      "Seasons": {
        "$season": {
          "Date": {
            "$date": {
              "$game": {
                "team1vote": {
                  "$uid": {
                    ".write": "auth != null && auth.uid == $uid",
                    ".validate": "newData.val() == 1"
                  }
                },
                "team2vote": {
                  "$uid": {
                    ".write": "auth != null && auth.uid == $uid",
                    ".validate": "newData.val() == 1"
                  }
                }
